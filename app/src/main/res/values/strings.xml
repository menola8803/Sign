    <string name="status_help_link">What do Sign 1 2 and Unsigned mean?</string>
    <string name="status_help_sign">Green: signature fields 1 and 2 are signed. The numbers are the fields in the document, in order – the same number you see when you sign (Field 2 · page 1).</string>
    <string name="status_help_unsigned">Red: no field is signed yet.</string>
    <string name="status_help_more">Fields that are still waiting are shown as Waiting for … when you open the document.</string>
