<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/relHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/relVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_bold"
            android:textColor="@color/gold"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/relTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_bold"
                android:textColor="@color/ink"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/relDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/relBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:fontFamily="@font/jakarta_bold"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:textColor="@color/mint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/relArrow"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/jakarta_bold"
            android:letterSpacing="0.12"
            android:text="@string/what_it_means"
            android:textColor="@color/gold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/relSummary"
            style="@style/Sign.AboutBody"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/jakarta_bold"
            android:letterSpacing="0.12"
            android:text="@string/what_it_contains"
            android:textColor="@color/gold"
            android:textSize="11sp" />
        <LinearLayout
            android:id="@+id/relChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
