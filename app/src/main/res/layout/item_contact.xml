<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/cInitial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar"
        android:fontFamily="@font/jakarta_bold"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/cName" style="@style/Sign.Value" android:layout_marginTop="0dp" android:fontFamily="@font/jakarta_bold" />
        <TextView android:id="@+id/cDetails" style="@style/Sign.Label" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/gold"
        android:textSize="24sp" />
</LinearLayout>
