<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cameraRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Ram i 3:4 som visar vad som kommer med på fotot -->
    <View
        android:id="@+id/cameraFrame"
        android:layout_width="240dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:layout_marginBottom="60dp"
        android:background="@drawable/bg_camera_frame" />

    <!-- Ring där man tryckte för att fokusera -->
    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_focus_ring"
        android:visibility="invisible" />

    <!-- Zoomnivå när man nyper med två fingrar -->
    <TextView
        android:id="@+id/zoomLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="150dp"
        android:background="@drawable/bg_hint"
        android:fontFamily="@font/jakarta_bold"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/gold"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cameraHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_hint"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:text="@string/camera_hint"
        android:textColor="@color/gold_pale"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/cameraBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/btnCameraCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center_vertical"
            android:text="@string/cancel"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <View
            android:id="@+id/btnShutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_shutter"
            android:clickable="true"
            android:contentDescription="@string/photo_take"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnFlip"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center_vertical|end"
            android:text="@string/camera_flip"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
