<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/docRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="80dp"
        android:paddingBottom="120dp" />

    <!-- Tonad kant under rubriken, som i Trace -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/docName"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:ellipsize="middle"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/docMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:textColor="@color/mint"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Svart under statusraden -->
    <View
        android:id="@+id/statusBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="#FF000000" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="90dp"
        android:background="@drawable/bg_hint"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"
        android:textColor="@color/gold_pale"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_toolbar"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnSignField"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tool"
            android:drawableTop="@drawable/ic_sign_field"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center"
            android:paddingTop="9dp"
            android:text="@string/add_signature"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPhoto"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tool"
            android:drawableTop="@drawable/ic_photo"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center"
            android:paddingTop="9dp"
            android:text="@string/add_photo"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnStamp"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tool"
            android:drawableTop="@drawable/ic_stamp"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center"
            android:paddingTop="9dp"
            android:text="@string/add_stamp"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_button_primary"
            android:drawableTop="@drawable/ic_save"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center"
            android:paddingTop="9dp"
            android:text="@string/save_signed"
            android:textColor="@color/on_gold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Vrid stämpeln: reglage −45..45°, ±5° och 0° -->
    <LinearLayout
        android:id="@+id/rotatePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_rotate_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/rotate_stamp"
                android:textColor="@color/ink"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/rotateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_bold"
                android:textColor="@color/gold"
                android:textSize="15sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/rotateSeek"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:max="90"
            android:progress="45" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/rotMinus" style="@style/Sign.RotBtn" android:text="−5°" />
            <TextView android:id="@+id/rotZero" style="@style/Sign.RotBtn" android:layout_marginStart="6dp" android:text="0°" />
            <TextView android:id="@+id/rotPlus" style="@style/Sign.RotBtn" android:layout_marginStart="6dp" android:text="+5°" />
            <TextView
                android:id="@+id/rotDone"
                style="@style/Sign.RotBtn"
                android:layout_marginStart="6dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_button_primary"
                android:text="@string/done"
                android:textColor="@color/on_gold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B1416"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/gold" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
