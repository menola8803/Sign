<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:contentDescription="Sign"
                android:src="@drawable/sign_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/cinzel_bold"
                android:letterSpacing="0.32"
                android:shadowColor="#4DE8B04A"
                android:shadowRadius="18"
                android:text="SIGN"
                android:textColor="@color/gold"
                android:textSize="38sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jakarta_bold"
                android:letterSpacing="0.22"
                android:text="@string/tagline"
                android:textColor="@color/mint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/jakarta_bold"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink"
                android:textSize="26sp" />

            <!-- Öppna dokument -->
            <LinearLayout
                android:id="@+id/cardOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_gold"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_doc" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Sign.Value" android:layout_marginTop="0dp" android:fontFamily="@font/jakarta_bold" android:textSize="18sp" android:text="@string/open_document" />
                    <TextView style="@style/Sign.Label" android:text="@string/open_document_sub" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/gold"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- Inställningar och utveckling -->
            <LinearLayout style="@style/Sign.Card" android:layout_marginTop="12dp" android:paddingVertical="4dp">
                <LinearLayout
                    android:id="@+id/rowSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_chip"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_settings" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/Sign.Value" android:layout_marginTop="0dp" android:fontFamily="@font/jakarta_bold" android:text="@string/settings" />
                        <TextView android:id="@+id/profileLine" style="@style/Sign.Label" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/gold" android:textSize="24sp" />
                </LinearLayout>

                <View style="@style/Sign.Divider" android:layout_marginVertical="0dp" />

                <LinearLayout
                    android:id="@+id/rowContacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_chip"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_contacts" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/Sign.Value" android:layout_marginTop="0dp" android:fontFamily="@font/jakarta_bold" android:text="@string/contacts" />
                        <TextView android:id="@+id/contactsLine" style="@style/Sign.Label" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/gold" android:textSize="24sp" />
                </LinearLayout>

                <View style="@style/Sign.Divider" android:layout_marginVertical="0dp" />

                <LinearLayout
                    android:id="@+id/rowDev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_icon_chip"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_code" />
                        <View
                            android:id="@+id/updateDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_dot"
                            android:visibility="gone" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/Sign.Value" android:layout_marginTop="0dp" android:fontFamily="@font/jakarta_bold" android:text="@string/dev_title" />
                        <TextView style="@style/Sign.Label" android:text="@string/dev_sub" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/gold" android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/privacy_note"
                android:textColor="@color/dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/homeVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/developer_line"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Tonad kant i toppen, som i Trace -->
    <View
        android:id="@+id/statusBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/bg" />

    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top" />

    <!-- S.N.C-loggan i vänstra hörnet -->
    <ImageView
        android:id="@+id/sncLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/company_full"
        android:src="@drawable/snc_logo" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings" />
</FrameLayout>
