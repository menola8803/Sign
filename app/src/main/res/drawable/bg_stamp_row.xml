<?xml version="1.0" encoding="utf-8"?>
<!-- Stämpelrad: guldram och guldton när den är vald -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33E8B04A">
    <item>
        <selector>
            <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="#26E8B04A" /><corners android:radius="14dp" /><stroke android:width="2dp" android:color="@color/gold" /></shape></item>
            <item><shape android:shape="rectangle"><solid android:color="@color/chip" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/line" /></shape></item>
        </selector>
    </item>
</ripple>
